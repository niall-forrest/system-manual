---
import Layout from "../../layouts/Layout.astro";
import { projects, projectIndex } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const { slug } = Astro.params;
const { current, next, number, total } = projectIndex(slug!);

if (!current) {
  return Astro.redirect("/");
}

const outcome = current.whatChanged
  ? { heading: "What changed", body: current.whatChanged }
  : current.whereItLanded
  ? { heading: "Where it landed", body: current.whereItLanded }
  : null;

const title = `${current.title} — Niall Forrest`;
---

<Layout title={title} description={current.oneLiner}>
  <article class="project">
    <header class="project__hero" style={`--swatch: ${current.swatch}`}>
      <div class="container project__hero-inner">
        <div class="project__meta">
          <a class="project__back" href="/#work">← Selected work</a>
          <span>{number} / {total}</span>
        </div>

        <span class="eyebrow project__eyebrow">{current.category}</span>

        <h1 class="project__title">{current.title}<span class="project__dot">.</span></h1>

        {current.caseStudyHeading && (
          <p class="project__heading">{current.caseStudyHeading}</p>
        )}

        <p class="project__one-liner">{current.oneLiner}</p>
      </div>
    </header>

    <section class="project__body">
      <div class="container project__grid">
        <aside class="project__sidebar">
          <dl class="project__facts">
            <div class="project__fact">
              <dt>Status</dt>
              <dd>{current.status}</dd>
            </div>
            <div class="project__fact">
              <dt>Role</dt>
              <dd>{current.role}</dd>
            </div>
            {current.stack && (
              <div class="project__fact">
                <dt>Stack</dt>
                <dd>{current.stack}</dd>
              </div>
            )}
            <div class="project__fact">
              <dt>Tags</dt>
              <dd>
                <ul class="project__tags">
                  {current.tags.map((tag) => <li>{tag}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
        </aside>

        <div class="project__prose">
          <section class="project__section">
            <h2 class="project__section-title">Context</h2>
            <p>{current.context}</p>
          </section>

          <section class="project__section">
            <h2 class="project__section-title">What I did</h2>
            <p>{current.whatIDid}</p>
          </section>

          {current.whatWasTricky && (
            <section class="project__section">
              <h2 class="project__section-title">What was tricky</h2>
              <p>{current.whatWasTricky}</p>
            </section>
          )}

          {outcome && (
            <section class="project__section">
              <h2 class="project__section-title">{outcome.heading}</h2>
              <p>{outcome.body}</p>
            </section>
          )}

          {current.confidentiality && (
            <p class="project__confidentiality">{current.confidentiality}</p>
          )}
        </div>
      </div>
    </section>

    <a class="project__next" href={`/work/${next.slug}`} style={`--swatch: ${next.swatch}`}>
      <div class="container project__next-inner">
        <div class="project__next-strip">
          <span class="project__next-label">Next project</span>
          <span class="project__next-sep" aria-hidden="true">/</span>
          <span class="project__next-category">{next.category}</span>
        </div>
        <div class="project__next-row">
          <h2 class="project__next-title">{next.title}<span class="project__dot">.</span></h2>
          <span class="project__next-arrow" aria-hidden="true">→</span>
        </div>
      </div>
    </a>
  </article>
</Layout>

<style>
  .project {
    display: block;
  }

  .project__hero {
    background: var(--swatch, var(--color-fg));
    color: var(--color-inverse-fg);
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 9vw, 8rem);
    border-bottom: var(--border);
  }

  .project__hero-inner {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .project__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(246, 244, 239, 0.7);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(246, 244, 239, 0.18);
  }

  .project__back {
    color: rgba(246, 244, 239, 0.7);
  }
  .project__back:hover {
    color: var(--color-inverse-fg);
  }

  .project__eyebrow {
    color: rgba(246, 244, 239, 0.65) !important;
  }

  .project__title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 11vw, 9.5rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
    font-weight: 500;
    margin: 0;
  }

  .project__dot {
    color: var(--color-accent);
  }

  .project__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: var(--tracking-tight);
    max-width: 28ch;
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid rgba(246, 244, 239, 0.18);
  }

  .project__one-liner {
    font-size: var(--fs-md);
    max-width: 60ch;
    color: rgba(246, 244, 239, 0.82);
  }

  .project__body {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .project__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .project__sidebar {
    border-top: var(--border);
  }

  .project__facts {
    margin: 0;
    padding: 0;
    display: grid;
  }

  .project__fact {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-soft);
  }

  .project__fact dt {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }

  .project__fact dd {
    font-size: var(--fs-sm);
    margin: 0;
    line-height: 1.45;
  }

  .project__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project__tags li {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 8px;
    border: var(--border-soft);
  }

  .project__prose {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .project__section p {
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    max-width: 62ch;
  }

  .project__section-title {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
    font-weight: 500;
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-soft);
  }

  .project__confidentiality {
    font-size: var(--fs-sm);
    color: var(--color-muted);
    font-style: italic;
    max-width: 62ch;
    padding-top: var(--space-5);
    border-top: var(--border-soft);
  }

  @media (min-width: 900px) {
    .project__grid {
      grid-template-columns: minmax(220px, 1fr) 2.4fr;
      gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }
    .project__sidebar {
      position: sticky;
      top: 88px;
    }
  }

  .project__next {
    display: block;
    background: var(--swatch, var(--color-inverse-bg));
    color: var(--color-inverse-fg);
    border-top: var(--border);
    transition: filter 220ms ease;
  }

  .project__next:hover {
    color: var(--color-inverse-fg);
    filter: brightness(1.08);
  }

  .project__next-inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .project__next-strip {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(246, 244, 239, 0.7);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(246, 244, 239, 0.22);
  }

  .project__next-sep {
    opacity: 0.5;
  }

  .project__next-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .project__next-title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 9vw, 7.5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.045em;
    margin: 0;
    max-width: 14ch;
  }

  .project__next-arrow {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1;
    flex-shrink: 0;
    align-self: flex-end;
    padding-bottom: 0.15em;
    transition: transform 240ms ease;
  }

  .project__next:hover .project__next-arrow {
    transform: translateX(0.5rem);
  }
</style>

---
const email = "hello@niallforrest.com";
const linkedin = "https://www.linkedin.com/in/niallforrest";
---

<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <span class="eyebrow contact__eyebrow">Contact</span>

    <h2 id="contact-title" class="contact__title">
      Send the<br />
      <span class="contact__title--accent">messy bit.</span>
    </h2>

    <p class="contact__lede">
      The half-formed ideas, the workflows nobody's untangled yet, the product
      that almost works but doesn't quite. Open to good projects with decent
      people.
    </p>

    <div class="contact__channels">
      <a class="contact__channel" href={`mailto:${email}`}>
        <span class="contact__channel-label">Email</span>
        <span class="contact__channel-value">{email}</span>
        <span class="contact__channel-arrow" aria-hidden="true">→</span>
      </a>
      <a
        class="contact__channel"
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact__channel-label">LinkedIn</span>
        <span class="contact__channel-value">/in/niallforrest</span>
        <span class="contact__channel-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-inverse-bg);
    color: var(--color-inverse-fg);
    border-top: var(--border);
  }

  .contact :global(.eyebrow) {
    color: rgba(246, 244, 239, 0.6);
  }

  .contact__inner {
    display: grid;
    gap: var(--space-6);
  }

  .contact__title {
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    line-height: var(--lh-tight);
    letter-spacing: -0.05em;
    font-weight: 500;
    margin: 0;
    max-width: 14ch;
  }

  .contact__title--accent {
    color: var(--color-accent);
  }

  .contact__lede {
    font-size: var(--fs-md);
    max-width: 50ch;
    color: rgba(246, 244, 239, 0.78);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(246, 244, 239, 0.18);
  }

  .contact__channels {
    margin-top: var(--space-6);
    border-top: 1px solid rgba(246, 244, 239, 0.18);
  }

  .contact__channel {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
    border-bottom: 1px solid rgba(246, 244, 239, 0.18);
    transition: color 150ms ease, padding-inline 150ms ease;
  }

  .contact__channel:hover {
    color: var(--color-accent);
    padding-inline: var(--space-3);
  }

  .contact__channel-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(246, 244, 239, 0.6);
  }

  .contact__channel-value {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }

  .contact__channel-arrow {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    justify-self: end;
  }
</style>

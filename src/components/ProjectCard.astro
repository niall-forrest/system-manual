---
interface Props {
  index: string;
  slug: string;
  title: string;
  description: string;
  tags: string[];
  category: string;
  swatch?: string;
}

const { index, slug, title, description, tags, category, swatch = "#0a0a0a" } = Astro.props;
---

<article class="card">
  <a href={`/work/${slug}`} class="card__link" aria-label={`Read about ${title}`}>
    <div class="card__media" aria-hidden="true">
      <div class="card__square" style={`--swatch: ${swatch}`}>
        <span class="card__index">{index}</span>
        <span class="card__category">{category}</span>
      </div>
    </div>

    <div class="card__body">
      <header class="card__head">
        <h3 class="card__title">{title}</h3>
      </header>
      <p class="card__desc">{description}</p>
      <ul class="card__tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </div>
  </a>
</article>

<style>
  .card {
    border-top: var(--border);
    padding-top: var(--space-5);
  }

  .card__link {
    display: grid;
    gap: var(--space-5);
  }

  .card__body {
    display: grid;
    gap: var(--space-4);
  }

  .card__link:hover .card__square {
    background: var(--color-accent);
  }

  .card__link:hover .card__title {
    color: var(--color-accent);
  }

  .card__media {
    width: 100%;
  }

  .card__square {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--swatch, var(--color-fg));
    color: var(--color-inverse-fg);
    overflow: hidden;
    transition: background 200ms ease;
    background-image:
      linear-gradient(var(--swatch, #0a0a0a), var(--swatch, #0a0a0a)),
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.06) 0 1px,
        transparent 1px 14px
      );
    background-blend-mode: normal;
  }

  .card__index {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-inverse-fg);
    opacity: 0.85;
  }

  .card__category {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    right: var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.3vw, 2rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-inverse-fg);
  }

  .card__head {
    padding-bottom: var(--space-3);
    border-bottom: var(--border-soft);
  }

  .card__title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    transition: color 120ms ease;
  }

  .card__desc {
    font-size: var(--fs-base);
    color: var(--color-fg);
    max-width: 50ch;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .card__tags li {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-fg);
    padding: 4px 8px;
    border: var(--border-soft);
  }
</style>

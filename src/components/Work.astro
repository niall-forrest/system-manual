---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
---

<section id="work" class="section work" aria-labelledby="work-title">
  <div class="container">
    <header class="section__header work__header">
      <div>
        <span class="eyebrow">Work</span>
        <h2 id="work-title" class="section__title">Selected<br />work.</h2>
      </div>
      <p class="section__lede">
        A mix of AI products, nonprofit platforms, cultural websites, and
        digital systems. Built for organisations with real audiences, real
        constraints, and things that need to work.
      </p>
    </header>

    <div class="work__grid">
      {projects.map((project, i) => (
        <ProjectCard
          index={`W/${String(i + 1).padStart(2, "0")}`}
          slug={project.slug}
          title={project.title}
          description={project.cardDescription}
          tags={project.tags}
          category={project.category}
          swatch={project.swatch}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .work__header {
    margin-bottom: var(--space-8);
  }

  .work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
  }

  @media (min-width: 720px) {
    .work__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-6);
      row-gap: var(--space-8);
    }
  }

  @media (min-width: 1100px) {
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
